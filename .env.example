# Flask configuration
# Required. Generate one with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=your-secret-key-here

# Login password (default: admin123; it will be hashed and stored automatically on first startup)
# It is recommended to change this to a strong password (at least 8 characters) through the Web UI after first startup
LOGIN_PASSWORD=admin123

# Application configuration
PORT=5000
HOST=0.0.0.0
FLASK_ENV=production

# Database path
DATABASE_PATH=data/outlook_accounts.db

# GPTMail temporary mailbox configuration
GPTMAIL_BASE_URL=https://mail.chatgpt.org.uk
GPTMAIL_API_KEY=gpt-test

# DuckMail temporary mailbox configuration
DUCKMAIL_BASE_URL=https://api.duckmail.sbs
DUCKMAIL_API_KEY=

# OAuth2 configuration (optional; defaults will be used if omitted)
# OAUTH_CLIENT_ID=your-client-id
# OAUTH_REDIRECT_URI=http://localhost:8080
